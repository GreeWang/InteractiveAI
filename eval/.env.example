# Copy to eval/.env (gitignored) or export in your shell.
# Never commit real keys.

# --- DeepSeek (default provider) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Alibaba Cloud Bailian / DashScope (OpenAI compatible-mode) ---
# Switch: export LLM_PROVIDER=bailian
# Then set DASHSCOPE_API_KEY (Bailian console → API-KEY).
# Beijing shared compatible base (still valid):
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# Completions URL becomes: .../compatible-mode/v1/chat/completions
# LLM_PROVIDER=bailian
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3.8-max

# --- Optional generic overrides (win over provider defaults when set) ---
# CLI --model / --base-url still win over these.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
