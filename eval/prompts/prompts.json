      "text_en": "Raise SphereB to y=2.0 keeping x/z; restore after.",
      "success_criteria": [
        "SphereB.y≈2.0 after edit"
      ],
      "automation": "baseline_cli",
      "baseline_action": "raise_sphere"
    },
    {
