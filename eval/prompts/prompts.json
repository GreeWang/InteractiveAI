      "automation": "check_cli",
      "constraint_file": "Assets/Prompt2Scene/Check/Constraints/P05_on_top.json"
    },
    {
      "id": "P06_constraint_distance",
      "phase": "constraint",
      "fixture": "F03",
      "scene": "Assets/Prompt2Scene/Fixtures/F03_ConstraintSandbox.unity",
