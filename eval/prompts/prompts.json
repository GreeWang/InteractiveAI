      "phase": "generate",
      "fixture": "F01",
      "scene": "Assets/Prompt2Scene/Fixtures/F01_EmptyRoom.unity",
      "text_zh": "在空场景沿 +X 摆放三个立方体 A B C，间距约 1 米。",
      "text_en": "Place cubes A B C along +X ~1m apart.",
      "success_criteria": [
        "exists:A,B,C",
        "spacing ≈1"
      ],
      "automation": "none",
      "notes": "Needs LLM/agent generation; not CLI-automated."
    }
